{
  "name": "board-game-simulator",
  "version": "0.74.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "eruda": "^3.4.3",
    "eslint": "^9.39.1",
    "react": "^19.2.0",
    "react-dice-complete": "^2.2.0",
    "react-dom": "^19.2.0",
    "react-responsive": "^10.0.0",
    "react-toastify": "^11.0.5",
    "typescript": "^4.9.5",
    "vite": "^7.2.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"public/**/*.{json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" \"public/**/*.{json,html}\"",
    "tiles:export": "node scripts/export-tiles-csv.js",
    "tiles:import": "node scripts/import-tiles-csv.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@svgr/rollup": "^8.1.0",
    "@vitejs/plugin-react": "^5.1.2",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.60.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "react-dice-complete": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
